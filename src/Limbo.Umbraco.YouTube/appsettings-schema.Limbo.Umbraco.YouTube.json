{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"Limbo": {
			"type": "object",
			"properties": {
				"YouTube": {
					"type": "object",
					"description": "Configuration for Limbo Umbraco YouTube.",
					"properties": {
						"Credentials": {
							"type": "array",
							"description": "The credentials configured for accessing the YouTube API.",
							"items": {
								"type": "object",
								"properties": {
									"Key": {
										"type": "string",
										"format": "uuid",
										"description": "The unique key of the credentials."
									},
									"Name": {
										"type": "string",
										"minLength": 1,
										"description": "The friendly name of the credentials."
									},
									"Description": {
										"type": "string",
										"description": "An optional description of the credentials."
									},
									"ApiKey": {
										"type": "string",
										"minLength": 1,
										"description": "The Google server API key used for accessing the YouTube API without a user context."
									}
								},
								"required": [
									"Key",
									"Name",
									"ApiKey"
								],
								"additionalProperties": false
							}
						}
					},
					"additionalProperties": false
				}
			}
		}
	}
}